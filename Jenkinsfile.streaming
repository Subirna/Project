pipeline {
    agent any

    // ==========================================================
    //  TFL REALTIME STREAMING PIPELINE — Subirna
    //
    //  Separate Jenkinsfile from the batch pipeline:
    //    Batch pipeline  (full load + incremental) → Jenkinsfile
    //    Streaming pipeline (real-time)            → THIS FILE
    //
    //  THREE PROCESSES started as background jobs on Cloudera:
    //
    //  1. Producer  (send_data_to_kafka.py)
    //     TFL API → Kafka topic: subirna_tfl_arrivals
    //     Polls every 30 seconds, sends raw JSON arrivals
    //
    //  2. Consumer  (write_kafka_to_hbase.py)
    //     Kafka → HBase: subirna_tfl_arrivals  (RAW table)
    //     Writes every individual arrival as a row
    //
    //  3. Spark Streaming  (streaming_spark.py)
    //     Kafka → Spark transforms → HBase: subirna_tfl_arrivals_agg
    //     Aggregates arrivals per station, updates every 30 seconds
    //
    //  TWO HBase TABLES:
    //    subirna_tfl_arrivals      ← raw data  (Consumer writes)
    //    subirna_tfl_arrivals_agg  ← transformed data (Spark writes)
    //
    //  Jenkins deploys all three and exits.
    //  All three keep running on the server until stopped.
    //
    //  To STOP all streaming (SSH to server):
    //    pkill -f send_data_to_kafka.py
    //    pkill -f write_kafka_to_hbase.py
    //    pkill -f streaming_spark.py
    // ==========================================================

    environment {
        REMOTE_HOST       = '13.41.167.97'
        REMOTE_USER       = 'consultant'
        REMOTE_PASSWORD   = 'Cl0ud3ra@2026#Secur3!'
        PROJECT_DIR       = '/home/consultant/subirna/TFL_Project'
        KAFKA_BROKER      = 'ip-172-31-6-42.eu-west-2.compute.internal:9092'
        KAFKA_TOPIC       = 'subirna_tfl_arrivals'
        HBASE_RAW_TABLE   = 'subirna_tfl_arrivals'
        HBASE_AGG_TABLE   = 'subirna_tfl_arrivals_agg'
        PRODUCER_LOG      = '/tmp/subirna_producer.log'
        CONSUMER_LOG      = '/tmp/subirna_consumer.log'
        SPARK_STREAM_LOG  = '/tmp/subirna_spark_streaming.log'
    }

    stages {

        // ======================================================
        //  STAGE 1: GIT CHECKOUT
        // ======================================================
        stage('Checkout') {
            steps {
                echo '========================================='
                echo 'Stage 1: Git Checkout'
                echo '========================================='
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        // ======================================================
        //  STAGE 2: PREPARE REMOTE DIRECTORY
        // ======================================================
        stage('Prepare Remote Directory') {
            steps {
                echo '========================================='
                echo 'Stage 2: Create Streaming Directory on Cloudera'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "mkdir -p ${PROJECT_DIR}/streaming" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "Directory ready: ${PROJECT_DIR}/streaming"
                '''
            }
        }

        // ======================================================
        //  STAGE 3: COPY ALL STREAMING SCRIPTS
        //
        //  send_data_to_kafka.py   → producer
        //  write_kafka_to_hbase.py → raw consumer
        //  streaming_spark.py      → Spark transform + agg consumer
        //  create_hbase_tables.sh  → HBase DDL (run in Stage 5)
        // ======================================================
        stage('Copy Streaming Scripts') {
            steps {
                echo '========================================='
                echo 'Stage 3: Copy all streaming scripts to Cloudera'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        src/streaming/send_data_to_kafka.py \
                        ${REMOTE_USER}@${REMOTE_HOST}:${PROJECT_DIR}/streaming/ 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sshpass -p "${REMOTE_PASSWORD}" scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        src/streaming/write_kafka_to_hbase.py \
                        ${REMOTE_USER}@${REMOTE_HOST}:${PROJECT_DIR}/streaming/ 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sshpass -p "${REMOTE_PASSWORD}" scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        src/streaming/streaming_spark.py \
                        ${REMOTE_USER}@${REMOTE_HOST}:${PROJECT_DIR}/streaming/ 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sshpass -p "${REMOTE_PASSWORD}" scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        src/streaming/create_hbase_tables.sh \
                        ${REMOTE_USER}@${REMOTE_HOST}:${PROJECT_DIR}/streaming/ 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "All scripts copied to ${PROJECT_DIR}/streaming/"
                '''
            }
        }

        // ======================================================
        //  STAGE 4: INSTALL PYTHON DEPENDENCIES
        //
        //  Installs the three libraries used by the Python scripts:
        //    requests     → TFL API HTTP calls  (producer)
        //    kafka-python → Kafka producer/consumer (producer + consumer)
        //    happybase    → HBase Thrift client  (consumer + Spark)
        //
        //  Install packages SEPARATELY so one failure does not block others.
        //
        //  happybase normally depends on thriftpy2 (needs C build from source,
        //  which fails on this cluster). Solution:
        //    1. Install the pure-Python 'thrift' library first
        //    2. Install happybase with --no-deps (skips thriftpy2)
        //  At runtime happybase tries thriftpy2 first, falls back to thrift.
        //
        //  Uses --user flag so no sudo required.
        //  Harmless to re-run — pip skips already-installed packages.
        // ======================================================
        stage('Install Python Dependencies') {
            steps {
                echo '========================================='
                echo 'Stage 4: Install Python packages on Cloudera'
                echo '  requests, kafka-python, thrift, happybase'
                echo '========================================='
                sh '''
                    echo "--- Upgrading pip (pip 9.0.3 is too old for modern package builds) ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "python3 -m pip install --user --upgrade pip 2>&1 | tail -2" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "--- Installing requests ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "python3 -m pip install --user requests 2>&1 | tail -3" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "--- Installing kafka-python ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "python3 -m pip install --user kafka-python 2>&1 | tail -3" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "--- Installing thrift (happybase backend) ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "python3 -m pip install --user thrift 2>&1 | tail -3" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "--- Installing happybase ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "python3 -m pip install --user happybase 2>&1 | tail -3" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "--- Verifying installs (pip show) ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "python3 -m pip show requests kafka-python thrift happybase 2>&1 | grep -E '^(Name|Version):'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        // ======================================================
        //  STAGE 5: CREATE KAFKA TOPIC (IF NOT EXISTS)
        //  Note: --if-not-exists is NOT supported with
        //  --bootstrap-server in Kafka 2.5 (CDH 7.1.7).
        //  Instead we create and ignore "already exists" error.
        // ======================================================
        stage('Create Kafka Topic') {
            steps {
                echo '========================================='
                echo 'Stage 5: Create Kafka Topic — subirna_tfl_arrivals'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "kafka-topics --bootstrap-server ${KAFKA_BROKER} \
                            --create \
                            --topic subirna_tfl_arrivals \
                            --partitions 1 \
                            --replication-factor 1 2>&1 | grep -v 'WARN' | grep -v 'already exists' || true" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "Kafka topic ready: subirna_tfl_arrivals"
                '''
            }
        }

        // ======================================================
        //  STAGE 6: CREATE BOTH HBase TABLES
        //
        //  Uses create_hbase_tables.sh (copied in Stage 3).
        //  Running HBase create via a script file avoids the
        //  SSH + shell quoting problem with single quotes inside
        //  double-quoted strings (HBase shell uses Ruby syntax
        //  where table names must be in single quotes).
        //
        //  Table 1: subirna_tfl_arrivals     ← RAW arrivals
        //  Table 2: subirna_tfl_arrivals_agg ← TRANSFORMED (Spark)
        //
        //  Safe to re-run — 'already exists' error is ignored.
        // ======================================================
        stage('Create HBase Tables') {
            steps {
                echo '========================================='
                echo 'Stage 6: Create both HBase tables'
                echo '  subirna_tfl_arrivals     (raw)'
                echo '  subirna_tfl_arrivals_agg (transformed)'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "bash ${PROJECT_DIR}/streaming/create_hbase_tables.sh" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo "Both HBase tables ready"
                '''
            }
        }

        // ======================================================
        //  STAGE 7: STOP OLD PROCESSES
        //  Kills all three previously running streaming processes.
        //  Makes pipeline safe to re-run (idempotent).
        // ======================================================
        stage('Stop Old Processes') {
            steps {
                echo '========================================='
                echo 'Stage 7: Stop any previously running streaming processes'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "pkill -f send_data_to_kafka.py 2>/dev/null && echo 'Stopped producer' || echo 'No producer running'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "pkill -f write_kafka_to_hbase.py 2>/dev/null && echo 'Stopped consumer' || echo 'No consumer running'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "pkill -f streaming_spark.py 2>/dev/null && echo 'Stopped Spark streaming' || echo 'No Spark streaming running'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sleep 3
                    echo "All old processes stopped"
                '''
            }
        }

        // ======================================================
        //  STAGE 8: START PRODUCER
        //  TFL API → Kafka topic: subirna_tfl_arrivals
        //  Polls every 30 seconds.
        // ======================================================
        stage('Start Producer') {
            steps {
                echo '========================================='
                echo 'Stage 8: Start Producer (TFL API → Kafka)'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "nohup python3 ${PROJECT_DIR}/streaming/send_data_to_kafka.py \
                            > ${PRODUCER_LOG} 2>&1 &
                         echo 'Producer PID:' \$!" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sleep 5
                    echo "Producer started — logs: ${PRODUCER_LOG}"
                '''
            }
        }

        // ======================================================
        //  STAGE 9: START CONSUMER (RAW → HBase)
        //  Kafka → HBase table: subirna_tfl_arrivals
        //  Writes every raw arrival as a single row.
        // ======================================================
        stage('Start Consumer') {
            steps {
                echo '========================================='
                echo 'Stage 9: Start Consumer (Kafka → HBase raw table)'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "nohup python3 ${PROJECT_DIR}/streaming/write_kafka_to_hbase.py \
                            > ${CONSUMER_LOG} 2>&1 &
                         echo 'Consumer PID:' \$!" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sleep 5
                    echo "Consumer started — logs: ${CONSUMER_LOG}"
                '''
            }
        }

        // ======================================================
        //  STAGE 10: START SPARK STRUCTURED STREAMING
        //
        //  Reads same Kafka topic as consumer.
        //  Transforms: aggregates arrivals per station per day.
        //  Writes to: HBase table subirna_tfl_arrivals_agg
        //
        //  Uses spark-submit with Kafka connector package.
        //  Runs with local[2]: 2 threads
        //    thread 1 → reads from Kafka
        //    thread 2 → processes + writes to HBase
        //
        //  Checkpoint saves progress to HDFS so it can resume
        //  after a restart without reprocessing old messages.
        // ======================================================
        stage('Start Spark Streaming') {
            steps {
                echo '========================================='
                echo 'Stage 10: Start Spark Structured Streaming'
                echo 'Kafka → Spark transforms → HBase aggregated table'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "nohup spark-submit \
                            --master local[2] \
                            --packages org.apache.spark:spark-sql-kafka-0-10_2.12:3.1.1 \
                            ${PROJECT_DIR}/streaming/streaming_spark.py \
                            > ${SPARK_STREAM_LOG} 2>&1 &
                         echo 'Spark Streaming PID:' \$!" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    sleep 10
                    echo "Spark Streaming started — logs: ${SPARK_STREAM_LOG}"
                '''
            }
        }

        // ======================================================
        //  STAGE 11: VERIFY ALL THREE PROCESSES ARE RUNNING
        // ======================================================
        stage('Verify Streaming Is Running') {
            steps {
                echo '========================================='
                echo 'Stage 11: Verify all 3 processes are running'
                echo '========================================='
                sh '''
                    echo "--- Running streaming processes ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "ps aux | grep -E 'send_data_to_kafka|write_kafka_to_hbase|streaming_spark' | grep -v grep" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo ""
                    echo "--- Producer log (last 3 lines) ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "tail -3 ${PRODUCER_LOG} 2>/dev/null || echo 'log not found'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo ""
                    echo "--- Consumer log (last 3 lines) ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "tail -3 ${CONSUMER_LOG} 2>/dev/null || echo 'log not found'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true

                    echo ""
                    echo "--- Spark Streaming log (last 3 lines) ---"
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "tail -3 ${SPARK_STREAM_LOG} 2>/dev/null || echo 'log not found'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

    }

    // ==========================================================
    //  POST ACTIONS
    // ==========================================================
    post {
        success {
            echo '========================================='
            echo 'TFL STREAMING PIPELINE DEPLOYED SUCCESSFULLY'
            echo ''
            echo 'All 3 processes running on Cloudera server:'
            echo ''
            echo "  Producer        : TFL API → Kafka (${KAFKA_TOPIC})"
            echo "  Consumer        : Kafka → HBase raw  (${HBASE_RAW_TABLE})"
            echo "  Spark Streaming : Kafka → HBase agg  (${HBASE_AGG_TABLE})"
            echo ''
            echo 'Logs on server:'
            echo "  tail -f ${PRODUCER_LOG}"
            echo "  tail -f ${CONSUMER_LOG}"
            echo "  tail -f ${SPARK_STREAM_LOG}"
            echo ''
            echo 'To verify HBase data:'
            echo "  echo \"scan 'subirna_tfl_arrivals', {LIMIT => 5}\" | hbase shell -n"
            echo "  echo \"scan 'subirna_tfl_arrivals_agg', {LIMIT => 5}\" | hbase shell -n"
            echo ''
            echo 'To stop all streaming:'
            echo '  pkill -f send_data_to_kafka.py'
            echo '  pkill -f write_kafka_to_hbase.py'
            echo '  pkill -f streaming_spark.py'
            echo '========================================='
        }
        failure {
            echo '========================================='
            echo 'TFL STREAMING PIPELINE FAILED — check logs above'
            echo '========================================='
        }
        always {
            echo 'Streaming pipeline execution completed'
        }
    }
}
